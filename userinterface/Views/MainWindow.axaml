<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:userinterface.ViewModels"
        xmlns:v="using:userinterface.Views"
        xmlns:vp="using:userinterface.Views.Profile"
		xmlns:controls="using:userinterface.Views.Controls"
		xmlns:ext="using:userinterface.Extensions"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="userinterface.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/mouse.ico"
        Title="userinterface"
        Background="{DynamicResource AppBackgroundBrush}"
        ExtendClientAreaToDecorationsHint="True">

	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<Window.Styles>
		<!-- Scrollbar Styles -->
		<Style Selector="ScrollBar">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
				</Transitions>
			</Setter>
		</Style>

		<Style Selector="ScrollBar:vertical">
			<Setter Property="Width" Value="8"/>
			<Setter Property="Opacity" Value="0.3"/>
		</Style>

		<Style Selector="ScrollBar:vertical:pointerover">
			<Setter Property="Width" Value="12"/>
			<Setter Property="Opacity" Value="0.8"/>
		</Style>

		<Style Selector="ScrollBar /template/ Thumb">
			<Setter Property="Background" Value="{DynamicResource DisabledTextBrush}"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.2"/>
				</Transitions>
			</Setter>
		</Style>

		<Style Selector="ScrollBar /template/ Thumb:pointerover">
			<Setter Property="Background" Value="{DynamicResource SecondaryTextBrush}"/>
		</Style>

		<Style Selector="ScrollBar /template/ Thumb:pressed">
			<Setter Property="Background" Value="{DynamicResource PrimaryTextBrush}"/>
		</Style>

		<Style Selector="ScrollBar /template/ RepeatButton">
			<Setter Property="IsVisible" Value="False"/>
		</Style>

		<!-- Sidebar Styles -->
		<Style Selector="Border.SidebarBorder">
			<Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Margin" Value="16"/>
			<Setter Property="Padding" Value="24"/>
			<Setter Property="Width" Value="400"/>
		</Style>

		<Style Selector="TextBlock.SidebarTitle">
			<Setter Property="FontSize" Value="28"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
			<Setter Property="Margin" Value="15,24,0,16"/>
			<Setter Property="HorizontalAlignment" Value="Left"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<!-- Navigation Button Styles -->
		<Style Selector="Button.NavButton">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
			<Setter Property="Padding" Value="16,8"/>
			<Setter Property="Margin" Value="4,0"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<ControlTemplate>
					<Border Name="PART_LayoutRoot"
							Background="{TemplateBinding Background}"
							CornerRadius="{TemplateBinding CornerRadius}"
							Padding="{TemplateBinding Padding}">
						<TextBlock Text="{TemplateBinding Content}"
								   FontFamily="{TemplateBinding FontFamily}"
								   FontSize="{TemplateBinding FontSize}"
								   FontWeight="{TemplateBinding FontWeight}"
								   Foreground="{TemplateBinding Foreground}"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"
								   Background="Transparent"/>
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>

		<Style Selector="Button.NavButton:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
		</Style>

		<Style Selector="Button.NavButton.Selected">
			<Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
		</Style>

		<Style Selector="Button.NavButton.Selected:pointerover">
			<Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
		</Style>

		<Style Selector="Button.NavButton:pressed">
			<Setter Property="RenderTransform" Value="scale(0.95)"/>
		</Style>

		<!-- Content Area Styles -->
		<Style Selector="Border.ContentArea">
			<Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="24"/>
			<Setter Property="Margin" Value="16"/>
		</Style>

		<!-- Apply Button Styles -->
		<Style Selector="Button.ApplyButton">
			<Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="24,12"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="Margin" Value="0,24,0,0"/>
			<Setter Property="Template">
				<ControlTemplate>
					<Border Name="PART_LayoutRoot"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{TemplateBinding CornerRadius}"
							Padding="{TemplateBinding Padding}">
						<TextBlock Text="{TemplateBinding Content}"
								   FontFamily="{TemplateBinding FontFamily}"
								   FontSize="{TemplateBinding FontSize}"
								   FontWeight="{TemplateBinding FontWeight}"
								   Foreground="{TemplateBinding Foreground}"
								   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								   VerticalAlignment="Center"
								   Background="Transparent"/>
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>

		<Style Selector="Button.ApplyButton:pointerover">
			<Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
		</Style>

		<Style Selector="Button.ApplyButton:pressed">
			<Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBrush}"/>
		</Style>

		<Style Selector="Button.ApplyButton:disabled">
			<Setter Property="Background" Value="{DynamicResource DisabledButtonBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
			<Setter Property="Opacity" Value="0.6"/>
		</Style>

		<!-- Loading Progress Bar Styles -->
		<Style Selector="ProgressBar.LoadingBar">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource SuccessButtonBrush}"/>
			<Setter Property="Height" Value="4"/>
			<Setter Property="CornerRadius" Value="2"/>
			<Setter Property="Margin" Value="0,8,0,0"/>
		</Style>

		<!-- Theme Toggle Button Styles -->
		<Style Selector="ToggleButton.ThemeToggle">
			<Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="25"/>
			<Setter Property="Width" Value="40"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>

		<Style Selector="ToggleButton.ThemeToggle:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
		</Style>

		<Style Selector="ToggleButton.ThemeToggle:checked">
			<Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBrush}"/>
		</Style>

		<Style Selector="ToggleButton.ThemeToggle:checked:pointerover">
			<Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
		</Style>

		<Style Selector="ToggleButton.ThemeToggle:pressed">
			<Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonPressedBrush}"/>
			<Setter Property="RenderTransform" Value="scale(0.95)"/>
		</Style>

		<!-- Settings Button Styles -->
		<Style Selector="Button.SettingsButton">
			<Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="25"/>
			<Setter Property="Width" Value="40"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>

		<Style Selector="Button.SettingsButton:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
		</Style>

		<Style Selector="Button.SettingsButton.Selected">
			<Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBrush}"/>
		</Style>

		<Style Selector="Button.SettingsButton.Selected:pointerover">
			<Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
		</Style>

		<Style Selector="Button.SettingsButton:pressed">
			<Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonPressedBrush}"/>
			<Setter Property="RenderTransform" Value="scale(0.95)"/>
		</Style>

		<!-- Separator Styles -->
		<Style Selector="Border.ProfileSeparator">
			<Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
			<Setter Property="Height" Value="1"/>
			<Setter Property="Margin" Value="8,12"/>
			<Setter Property="Opacity" Value="0.5"/>
		</Style>

		<!-- Transitions -->
		<!-- Transitions -->
		<!-- Removed BrushTransition for Background and BorderBrush to prevent grey interpolation flashes and ClearType fringing artifacts during hover state changes -->
		<Style Selector="Button.NavButton">
			<Setter Property="Transitions">
				<Transitions>
					<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>

		<Style Selector="Button.ApplyButton">
			<Setter Property="Transitions">
				<Transitions>
					<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
				</Transitions>
			</Setter>
		</Style>

		<Style Selector="ToggleButton.ThemeToggle">
			<Setter Property="Transitions">
				<Transitions>
					<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
				</Transitions>
			</Setter>
		</Style>

		<Style Selector="Button.SettingsButton">
			<Setter Property="Transitions">
				<Transitions>
					<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
				</Transitions>
			</Setter>
		</Style>
	</Window.Styles>

	<DockPanel>
		<!-- TOP NAVIGATION BAR -->
		<Border DockPanel.Dock="Top" 
				Height="64" 
				Background="{DynamicResource CardBackgroundBrush}" 
				BorderBrush="{DynamicResource BorderBrush}" 
				BorderThickness="0,0,0,1"
				PointerPressed="OnTitleBarPointerPressed"
				BackgroundSizing="InnerBorderEdge">
			<Grid ColumnDefinitions="Auto, *, Auto">
				
				<!-- Brand -->
				<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">
					<!-- Optional Icon: <PathIcon Data="{StaticResource mouse_regular}" Width="24" Height="24" Foreground="{DynamicResource PrimaryButtonBrush}"/> -->
					<TextBlock Text="Raw Accel" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
				</StackPanel>

				<!-- Navigation Tabs -->
				<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
					<Button Classes="NavButton" Name="ProfilesButton" Tag="Profiles" Content="{ext:Localized MainWindowProfilesButton}"/>
					<Button Classes="NavButton" Name="DevicesButton" Tag="Devices" Content="{ext:Localized MainWindowDevicesButton}"/>
					<Button Classes="NavButton" Name="MappingsButton" Tag="Mappings" Content="{ext:Localized MainWindowMappingsButton}"/>
				</StackPanel>

				<!-- Actions -->
				<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,140,0" Spacing="16">
					<Button Classes="SettingsButton" Name="SettingsButton">
						<PathIcon Data="{StaticResource settings_regular}" Width="16" Height="16"/>
					</Button>
					<ToggleButton Classes="ThemeToggle" Name="ThemeToggleButton">
						<PathIcon Data="{StaticResource weather_moon_regular}" Width="16" Height="16" Name="ThemeIcon"/>
					</ToggleButton>
					
					<Button Classes="ApplyButton" Name="ApplyButton" Content="{ext:Localized MainWindowApplySettingsButton}" Padding="16,8" Margin="0"/>
					
					<ProgressBar Classes="LoadingBar" Name="LoadingProgress" IsVisible="False" IsIndeterminate="True"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- MAIN CONTENT -->
		<Panel>
			<ContentControl Content="{Binding CurrentPageContent}" Margin="24"/>
			<controls:ToastView DataContext="{Binding ToastViewModel}" />
			<controls:ModalOverlay Name="ModalOverlay" />
		</Panel>
	</DockPanel>
</Window>