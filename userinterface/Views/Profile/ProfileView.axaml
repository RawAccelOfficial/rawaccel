<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:userinterface.ViewModels.Profile"
             xmlns:v="using:userinterface.Views"
             xmlns:vp="using:userinterface.Views.Profile"
             xmlns:ext="using:userinterface.Extensions"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="userinterface.Views.Profile.ProfileView"
             x:DataType="vm:ProfileViewModel">

	<UserControl.Styles>
		<Style Selector="Border.SectionBorder">
			<Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="16"/>
		</Style>
	</UserControl.Styles>

	<!-- Increased width from 420 to 460 to ensure wider ComboBox items like 'Synchronous' fit without truncation -->
	<Grid ColumnDefinitions="460,*">
		<Border Grid.Column="0"
				Margin="0,0,16,0"
				VerticalAlignment="Stretch"
				Background="{DynamicResource CardBackgroundBrush}"
				CornerRadius="8">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="16">
					<!-- Profile Selection List -->
					<TextBlock Text="{ext:Localized MainWindowProfilesButton}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="{DynamicResource PrimaryTextBrush}"/>
					<vp:ProfileListView Name="ProfileListView" DataContext="{Binding ProfileList}" Margin="0,0,0,24"/>
					
					<!-- Settings Content -->
					<ContentControl Content="{Binding Settings}"/>
				</StackPanel>
			</ScrollViewer>
		</Border>

		<ContentControl Grid.Column="1" 
					   Content="{Binding Chart}" 
					   HorizontalAlignment="Stretch" 
					   VerticalAlignment="Stretch"/>
	</Grid>
</UserControl>
